      "function DockerGet([string]$path){ $pipe=New-Object System.IO.Pipes.NamedPipeClientStream('.','docker_engine',[System.IO.Pipes.PipeDirection]::InOut); try { $pipe.Connect(1500); $req=[Text.Encoding]::ASCII.GetBytes(\"GET $path HTTP/1.0`r`nHost: localhost`r`nConnection: close`r`n`r`n\"); $pipe.Write($req,0,$req.Length); $pipe.Flush(); $ms=New-Object System.IO.MemoryStream; $buf=New-Object byte[] 8192; while(($n=$pipe.Read($buf,0,$buf.Length)) -gt 0){ $ms.Write($buf,0,$n) }; $raw=[Text.Encoding]::UTF8.GetString($ms.ToArray()); $idx=$raw.IndexOf(\"`r`n`r`n\"); if($idx -lt 0){ return $null }; if($raw.Substring(0,$idx) -notmatch '^HTTP/1\\.[01]\\s+200\\b'){ return $null }; return ($raw.Substring($idx+4) | ConvertFrom-Json) } finally { $pipe.Dispose() } }",
