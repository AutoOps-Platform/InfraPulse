      "cat <<'IP_DOCKER_EOF' > \"$root/docker-state.sh\"",
      "#!/bin/bash",
      "set -euo pipefail",
      "dir=/var/lib/infrapulse-agent/textfile; tmp=\"$dir/containers.prom.tmp\"; out=\"$dir/containers.prom\"",
      "mkdir -p -m 0700 \"$dir\"",
      "if [[ ! -S /var/run/docker.sock ]] || ! command -v docker >/dev/null 2>&1; then printf 'infrapulse_docker_present 0\\n' > \"$tmp\"; mv -f \"$tmp\" \"$out\"; exit 0; fi",
      "{",
      "  printf '# TYPE infrapulse_docker_present gauge\\ninfrapulse_docker_present 1\\n'",
      "  ids=$(docker ps -aq 2>/dev/null || true)",
      "  if [[ -n $ids ]]; then",
      "    docker inspect $ids 2>/dev/null | jq -r '",
      "      def esc: tostring | gsub(\"[\\\"\\n\\r\\\\\\\\]\"; \" \");",
      "      def state_code: if . == \"running\" then 1 elif . == \"restarting\" then 2 elif . == \"paused\" then 3 elif . == \"dead\" then 4 elif . == \"created\" then 5 else 0 end;",
      "      def health_code: if . == \"healthy\" then 1 elif . == \"unhealthy\" then 2 elif . == \"starting\" then 3 else 0 end;",
      "      .[] | (.Name | ltrimstr(\"/\")) as $name | (.Id[0:12]) as $cid | (.Config.Image // \"unknown\") as $img | (.State.Status // \"unknown\") as $st | (.State.Health.Status // \"none\") as $hl | (.Config.Labels[\"com.docker.compose.project\"] // \"-\") as $proj |",
      "      ((.NetworkSettings.Ports // {} | to_entries | map(if (.value | type) == \"array\" and (.value | length) > 0 then (.value[0].HostPort + \"->\" + .key) else .key end) | join(\",\")) | if . == \"\" then \"-\" else . end) as $ports |",
      "      (if $st == \"running\" then 1 else 0 end) as $running | (if .State.OOMKilled then 1 else 0 end) as $oom | (.RestartCount // 0) as $restarts | (.State.ExitCode // 0) as $exit | (.HostConfig.Memory // 0) as $memlim |",
      "      (if $st == \"running\" and ((.State.StartedAt // \"\") | test(\"^[0-9]{4}-\")) then (try (.State.StartedAt | sub(\"\\\\.[0-9]+Z$\"; \"Z\") | fromdateiso8601) catch 0) else 0 end) as $started |",
      "      \"infrapulse_container_info{container=\\\"\\($name|esc)\\\",container_id=\\\"\\($cid|esc)\\\",image=\\\"\\($img|esc)\\\",state=\\\"\\($st|esc)\\\",health=\\\"\\($hl|esc)\\\",compose_project=\\\"\\($proj|esc)\\\",ports=\\\"\\($ports|esc)\\\"} 1\",",
      "      \"infrapulse_container_running{container=\\\"\\($name|esc)\\\"} \\($running)\",",
      "      \"infrapulse_container_state_code{container=\\\"\\($name|esc)\\\"} \\($st | state_code)\",",
      "      \"infrapulse_container_health_code{container=\\\"\\($name|esc)\\\"} \\($hl | health_code)\",",
      "      \"infrapulse_container_restarts_total{container=\\\"\\($name|esc)\\\"} \\($restarts)\",",
      "      \"infrapulse_container_oom_killed{container=\\\"\\($name|esc)\\\"} \\($oom)\",",
      "      \"infrapulse_container_exit_code{container=\\\"\\($name|esc)\\\"} \\($exit)\",",
      "      \"infrapulse_container_started_timestamp_seconds{container=\\\"\\($name|esc)\\\"} \\($started)\",",
      "      \"infrapulse_container_memory_limit_bytes{container=\\\"\\($name|esc)\\\"} \\($memlim)\"",
      "    '",
      "  fi",
