{
  "linux": {
    "preamble": [
      "#!/bin/bash",
      "set +x; set +v; set -euo pipefail; umask 077",
      "export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C",
      "root=/var/lib/infrapulse-agent; cw=/opt/aws/amazon-cloudwatch-agent; action=@@ACTION@@; code=CONFIGURE_FAILED; version=null; service=null; resources='[]'; owns=false",
      "summary() { local result=$?; trap - EXIT; if [[ ${#resources} -gt 12000 ]]; then resources='[]'; code=SUMMARY_TOO_LARGE; result=1; fi; if [[ $action != prepare || $result != 0 ]]; then jq -cn --arg server '{{ ServerId }}' --arg enrollment '{{ EnrollmentId }}' --arg node '{{ ManagedNodeId }}' --arg operation '{{ OperationId }}' --arg config '{{ ConfigurationVersion }}' --arg step \"$action\" --arg error \"$code\" --argjson result \"$result\" --argjson version \"$version\" --argjson service \"$service\" --argjson resources \"$resources\" '{serverId:$server,enrollmentId:$enrollment,nodeId:$node,operationId:$operation,platform:\"linux\",configurationVersion:$config,step:$step,errorCode:(if $result==0 then null else $error end),cloudWatchVersion:$version,serviceState:$service,resources:$resources}' || printf '%s\\n' '{\"step\":\"prepare\",\"errorCode\":\"DEPENDENCY_UNAVAILABLE\",\"cloudWatchVersion\":null,\"serviceState\":null,\"resources\":[]}'; fi; if $owns && [[ $action != prepare || $result != 0 ]]; then rm -f -- \"$root/active\"; fi; exit \"$result\"; }; trap summary EXIT",
      "[[ $(id -u) == 0 && '{{ Platform }}' == linux ]]",
      "if ! command -v jq >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 || true; DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null 2>&1 || true; fi",
      "for tool in jq flock findmnt timeout sha256sum systemctl; do command -v \"$tool\" >/dev/null; done",
      "mkdir -p -m 0700 -- \"$root\"",
      "exec 9>\"$root/lock\"; code=CONFLICT; flock -w 30 9",
      "owner='{{ ServerId }}:{{ EnrollmentId }}:{{ ManagedNodeId }}'",
      "printf '%s' \"$owner\" > \"$root/owner\"",
      "printf '%s' '{{ OperationId }}' > \"$root/active\"; owns=true",
      "release=$(printf '%s' '@@RELEASE@@' | base64 --decode)",
      "code=DECOMMISSIONED; if [[ $action != cleanup ]]; then [[ ! -e $root/decommission.requested ]]; fi",
      "code=PACKAGE_MISMATCH; agent=$cw/bin/amazon-cloudwatch-agent; downloader=$cw/bin/config-downloader; control=$cw/bin/amazon-cloudwatch-agent-ctl",
      "check_package() { [[ -x $agent && -x $downloader && -x $control ]]; }",
      "observe() { version=null; service=null; local status measured; measured=$(timeout 10s \"$agent\" -version 2>/dev/null) || return; measured=$(sed -n 's/^\\(AmazonCloudWatchAgent \\)\\?CWAgent\\/\\([0-9][0-9.b]*\\)\\([ \\t].*\\)\\?$/\\2/p' <<< \"$measured\"); [[ -n $measured && ${#measured} -le 64 ]] && version=$(jq -cn --arg v \"$measured\" '$v'); status=$(systemctl show -p ActiveState --value amazon-cloudwatch-agent.service 2>/dev/null) || return; case $status in active) service='\"running\"';; inactive) service='\"stopped\"';; failed) service='\"failed\"';; esac; }"
    ],
    "prepare": [
      "code=DEPENDENCY_UNAVAILABLE; [[ -f /root/.aws/credentials ]]"
    ],
    "configure": [
      "check_package; observe",
      "code=CREDENTIAL_SOURCE_UNSAFE; [[ -f /root/.aws/credentials ]]",
      "printf '[credentials]\\nshared_credential_profile = \"default\"\\nshared_credential_file = \"/root/.aws/credentials\"\\n' > \"$root/common-config.toml\"",
      "stage=$(mktemp -d \"$root/download.XXXXXXXX\"); code=PRESET_FETCH_FAILED",
      "HOME=/root AWS_REGION=ap-southeast-1 AWS_EC2_METADATA_DISABLED=true timeout 90s \"$downloader\" -download-source 'ssm:{{ PresetName }}:{{ PresetVersion }}' -output-dir \"$stage\" -mode onPremise -config \"$root/common-config.toml\" -multi-config default >/dev/null 2>&1",
      "files=(\"$stage\"/*); [[ ${#files[@]} == 1 && -f ${files[0]} ]]; code=PRESET_MISMATCH; [[ $(sha256sum -- \"${files[0]}\" | cut -d ' ' -f1) == $(jq -r '.parameter.sha256' <<< \"$release\") ]]",
      "code=RESOURCE_MISMATCH; iface=$(ip -o route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i==\"dev\") {print $(i+1); exit}}'); [[ -n $iface && -d /sys/class/net/$iface ]] || iface=$(ls /sys/class/net | grep -v '^lo$' | head -n 1); [[ -n $iface && -d /sys/class/net/$iface ]]",
      "while IFS= read -r r; do selector=$(jq -r .selector <<< \"$r\"); kind=$(jq -r .kind <<< \"$r\"); case $kind in cpu) dimensions='[{\"name\":\"cpu\",\"value\":\"cpu-total\"}]';; interface) dimensions=$(jq -cn --arg s \"$iface\" '[{name:\"interface\",value:$s}]');; filesystem) actual=$(findmnt --json --target \"$selector\" --output TARGET,SOURCE,FSTYPE); dimensions=$(jq -ce '.filesystems|select(length==1)|.[0]|[{name:\"device\",value:(.source|split(\"/\")|last)},{name:\"fstype\",value:.fstype},{name:\"path\",value:.target}]' <<< \"$actual\");; *) exit 1;; esac; resources=$(jq -c --argjson r \"$r\" --argjson d \"$dimensions\" '.+[{id:$r.id,kind:$r.kind,dimensions:$d}]' <<< \"$resources\"); done < <(jq -c '.configuration.plugins[].resources[]' <<< \"$release\")",
      "code=CONFIGURE_FAILED; [[ ! -e $root/config.json ]] || cp -- \"$root/config.json\" \"$root/previous.json\"",
      "sed 's/${ServerId}/{{ ServerId }}/g;s/${ManagedNodeId}/{{ ManagedNodeId }}/g;s/${EnrollmentId}/{{ EnrollmentId }}/g' \"${files[0]}\" | sed \"s/\\\"eth0\\\"/\\\"$iface\\\"/g\" > \"$root/config.json\"; rm -f -- \"${files[0]}\"; rmdir -- \"$stage\"",
      "cp -- \"$root/common-config.toml\" \"$cw/etc/common-config.toml\"; chmod 0600 \"$cw/etc/common-config.toml\"; [[ ! -e $root/decommission.requested ]]",
      "HOME=/root AWS_REGION=ap-southeast-1 AWS_EC2_METADATA_DISABLED=true timeout 90s \"$control\" -a fetch-config -m onPremise -c \"file:$root/config.json\" -s >/dev/null 2>&1",
      "observe; [[ $service == '\"running\"' ]]; [[ ${#resources} -le 12000 ]]"
    ]
  },
  "windows": {
    "preamble": [
      "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; $VerbosePreference='SilentlyContinue'; $DebugPreference='SilentlyContinue'",
      "$root='C:\\ProgramData\\InfraPulse Agent'; $cw='C:\\Program Files\\Amazon\\AmazonCloudWatchAgent'; $data='C:\\ProgramData\\Amazon\\AmazonCloudWatchAgent'; $action='@@ACTION@@'; $code='CONFIGURE_FAILED'; $version=$null; $state=$null; $resources=@(); $owns=$false; $lock=$null",
      "$release=ConvertFrom-Json ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('@@RELEASE@@')))",
      "function Safe($path,$private=$false) { $item=Get-Item -LiteralPath $path -Force; if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'unsafe' }; $acl=Get-Acl -LiteralPath $path; $trusted=@('S-1-5-18','S-1-5-32-544','S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464'); if ($acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -cnotin $trusted) { throw 'owner' }; foreach($r in $acl.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier])) { if ($r.AccessControlType -eq 'Allow' -and $r.IdentityReference.Value -cnotin $trusted -and -not ($r.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -and ($private -or ($r.FileSystemRights -band $(if($item.PSIsContainer){0xD0150}else{0xD0156})))) { throw 'acl' } } }",
      "function Save($path,$value) { $bytes=[Text.UTF8Encoding]::new($false).GetBytes($value); $f=[IO.File]::Open($path,[IO.FileMode]::Create,[IO.FileAccess]::Write,[IO.FileShare]::None); try { $f.Write($bytes,0,$bytes.Length); $f.Flush($true) } finally { $f.Dispose() } }",
      "function CheckPackage { foreach($p in @('C:\\Program Files','C:\\Program Files\\Amazon',$cw,'C:\\ProgramData\\Amazon',$data)) { Safe $p }; foreach($key in @('agent','downloader','control')) { $path=Get-Variable -Name $key -ValueOnly; Safe $path; if ((Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() -cne $release.cloudWatch.files.$key) { throw 'hash' }; if ($key -ne 'control') { $s=Get-AuthenticodeSignature -LiteralPath $path; if ($s.Status -ne 'Valid' -or $s.SignerCertificate.GetNameInfo([Security.Cryptography.X509Certificates.X509NameType]::SimpleName,$false) -cne $release.cloudWatch.signer.subject -or $s.SignerCertificate.GetCertHashString([Security.Cryptography.HashAlgorithmName]::SHA256).ToLowerInvariant() -cne $release.cloudWatch.signer.certificateSha256) { throw 'signer' } } } }",
      "function Observe { $script:version=$null; $script:state=$null; $v=& $agent -version 2>$null; if ($LASTEXITCODE -eq 0 -and [string]$v -match '^(?:AmazonCloudWatchAgent )?CWAgent/([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+|b[0-9]+)?)(?:[ \\t][\\x20-\\x7e]{1,256})?$') { $script:version=$Matches[1] }; $s=Get-Service -Name AmazonCloudWatchAgent -ErrorAction SilentlyContinue; if ($s.Status -eq 'Running') { $script:state='running' } elseif ($s.Status -eq 'Stopped') { $script:state='stopped' } }",
      "try {",
      "if ('{{ Platform }}' -cne 'windows' -or -not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'platform' }",
      "foreach($p in @('C:\\','C:\\ProgramData')) { Safe $p }; if (-not (Test-Path -LiteralPath $root)) { $acl=[Security.AccessControl.DirectorySecurity]::new(); $acl.SetAccessRuleProtection($true,$false); $acl.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-18')); foreach($sid in @('S-1-5-18','S-1-5-32-544')) { $acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($sid),'FullControl','ContainerInherit,ObjectInherit','None','Allow')) }; [void][IO.Directory]::CreateDirectory($root,$acl) }; Safe $root $true; if (-not (Get-Acl -LiteralPath $root).AreAccessRulesProtected) { throw 'acl' }; foreach($p in Get-ChildItem -LiteralPath $root -Force) { Safe $p.FullName }",
      "$code='CONFLICT'; $lock=[IO.File]::Open((Join-Path $root 'lock'),[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None); $owner='{{ ServerId }}:{{ EnrollmentId }}:{{ ManagedNodeId }}'; $ownerPath=Join-Path $root 'owner'; if (Test-Path -LiteralPath $ownerPath) { if ([IO.File]::ReadAllText($ownerPath) -cne $owner) { throw 'binding' } } else { $code='MANUAL_ADOPTION_REQUIRED'; if ($action -cne 'prepare' -or (Test-Path -LiteralPath $cw) -or (Get-Service -Name AmazonCloudWatchAgent -ErrorAction SilentlyContinue)) { throw 'adoption' }; Save $ownerPath $owner }",
      "$active=$null; $activePath=Join-Path $root 'active'; if (Test-Path -LiteralPath $activePath) { $active=[IO.File]::ReadAllText($activePath); if (-not (($action -ceq 'configure' -and $active -ceq '{{ OperationId }}') -or ($action -cne 'configure' -and '{{ PreviousOperationId }}' -cne '' -and '{{ PreviousOperationId }}' -cne '{{ OperationId }}' -and $active -ceq '{{ PreviousOperationId }}'))) { throw 'active' } }; if ($action -ceq 'configure' -and $active -cne '{{ OperationId }}') { throw 'active' }; Save $activePath '{{ OperationId }}'; $owns=$true",
      "$marker=Join-Path $root 'decommission.requested'; $code='DECOMMISSIONED'; if ($action -cne 'cleanup' -and (Test-Path -LiteralPath $marker)) { throw 'decommissioned' }; $code='PACKAGE_MISMATCH'; $agent=Join-Path $cw 'amazon-cloudwatch-agent.exe'; $downloader=Join-Path $cw 'config-downloader.exe'; $control=Join-Path $cw 'amazon-cloudwatch-agent-ctl.ps1'"
    ],
    "prepare": [
      "if (Test-Path -LiteralPath $cw) { CheckPackage; Observe; if ($version -cne $release.cloudWatch.version) { throw 'version' } }",
      "$code='CREDENTIAL_SOURCE_UNSAFE'; foreach($p in @('C:\\Windows','C:\\Windows\\System32','C:\\Windows\\System32\\config','C:\\Windows\\System32\\config\\systemprofile','C:\\Windows\\System32\\config\\systemprofile\\.aws','C:\\Windows\\System32\\config\\systemprofile\\.aws\\credentials')) { Safe $p }"
    ],
    "configure": [
      "CheckPackage; Observe; if ($version -cne $release.cloudWatch.version) { throw 'version' }; $code='CREDENTIAL_SOURCE_UNSAFE'; $credential='C:\\Windows\\System32\\config\\systemprofile\\.aws\\credentials'; Safe $credential $true; $svc=Get-CimInstance Win32_Service -Filter \"Name='AmazonCloudWatchAgent'\"; if ($svc.StartName -cne 'LocalSystem') { throw 'service identity' }",
      "foreach($p in @((Join-Path $data 'common-config.toml'),(Join-Path $root 'config.json'),(Join-Path $root 'previous.json'),(Join-Path $root 'common-config.toml'))) { if (Test-Path -LiteralPath $p) { Safe $p } }; $common=Join-Path $root 'common-config.toml'; Save $common ('[credentials]'+[Environment]::NewLine+'shared_credential_profile = \"default\"'+[Environment]::NewLine+\"shared_credential_file = 'C:\\Windows\\System32\\config\\systemprofile\\.aws\\credentials'\"+[Environment]::NewLine)",
      "$stage=Join-Path $root ([guid]::NewGuid().ToString('N')); [void][IO.Directory]::CreateDirectory($stage); $code='PRESET_FETCH_FAILED'; $env:AWS_EC2_METADATA_DISABLED='true'; & $downloader -download-source 'ssm:{{ PresetName }}:{{ PresetVersion }}' -output-dir $stage -mode onPremise -config $common -multi-config default *> $null; if ($LASTEXITCODE -ne 0) { throw 'download' }; $files=@(Get-ChildItem -LiteralPath $stage -Force); $code='PRESET_MISMATCH'; if ($files.Count -ne 1 -or $files[0].PSIsContainer -or $files[0].Length -gt 8192) { throw 'preset' }; Safe $files[0].FullName; if ((Get-FileHash -LiteralPath $files[0].FullName -Algorithm SHA256).Hash.ToLowerInvariant() -cne $release.parameter.sha256) { throw 'preset hash' }",
      "$code='RESOURCE_MISMATCH'; foreach($plugin in $release.configuration.plugins) { foreach($r in $plugin.resources) { $counter='\\'+$plugin.plugin+$(if($r.selector -ne ''){'('+$r.selector+')'})+'\\'+$plugin.measurements[0].input; $samples=@((Get-Counter -Counter $counter -MaxSamples 1).CounterSamples); if ($samples.Count -ne 1 -or $samples[0].Status -ne 0) { throw 'counter' }; $d=@(); if($r.kind -ne 'memory') { $d+=@{name='instance';value=[string]$samples[0].InstanceName} }; $d+=@{name='objectname';value=$plugin.plugin}; foreach($dimension in $r.dimensions) { if (@($d|Where-Object { $_.name -ceq $dimension.name -and $_.value -ceq $dimension.value }).Count -ne 1) { throw 'dimension' } }; $resources+=@{id=$r.id;kind=$r.kind;dimensions=$d} } }",
      "$code='CONFIGURE_FAILED'; $config=Join-Path $root 'config.json'; if (Test-Path -LiteralPath $config) { Copy-Item -LiteralPath $config -Destination (Join-Path $root 'previous.json') -Force }; $text=[IO.File]::ReadAllText($files[0].FullName).Replace('${ServerId}','{{ ServerId }}').Replace('${ManagedNodeId}','{{ ManagedNodeId }}').Replace('${EnrollmentId}','{{ EnrollmentId }}'); Save $config $text; Remove-Item -LiteralPath $files[0].FullName; [IO.Directory]::Delete($stage)",
      "Copy-Item -LiteralPath $common -Destination (Join-Path $data 'common-config.toml') -Force; if (Test-Path -LiteralPath $marker) { throw 'decommissioned' }; & $control -a fetch-config -m onPremise -c ('file:'+$config) -s *> $null; if ($LASTEXITCODE -ne 0) { throw 'control' }; Observe; if ($state -cne 'running' -or $version -cne $release.cloudWatch.version) { throw 'observation' }"
    ],
    "epilogue": [
      "$ok=$true",
      "} catch { $ok=$false } finally { if ($action -cne 'prepare' -or -not $ok) { $summary=@{serverId='{{ ServerId }}';enrollmentId='{{ EnrollmentId }}';nodeId='{{ ManagedNodeId }}';operationId='{{ OperationId }}';platform='windows';configurationVersion='{{ ConfigurationVersion }}';step=$action;errorCode=$(if($ok){$null}else{$code});cloudWatchVersion=$version;serviceState=$state;resources=@($resources)}; $json=ConvertTo-Json -InputObject $summary -Depth 8 -Compress; if ([Text.Encoding]::UTF8.GetByteCount($json) -gt 16384) { $ok=$false; $summary.resources=@(); $summary.errorCode='SUMMARY_TOO_LARGE'; $json=ConvertTo-Json -InputObject $summary -Depth 8 -Compress }; [Console]::WriteLine($json) }; if ($owns -and ($action -cne 'prepare' -or -not $ok)) { Remove-Item -LiteralPath $activePath -Force }; if($lock){$lock.Dispose()} }; if (-not $ok) { exit 1 }"
    ]
  }
}
