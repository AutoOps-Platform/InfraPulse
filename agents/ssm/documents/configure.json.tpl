      "mv -f \"$tmp\" \"$out\"",
      "IP_DOCKER_EOF",
      "chmod 0700 \"$root/docker-state.sh\"",
      "printf '%s\\n' '[Unit]' 'Description=InfraPulse Docker Container State Collector' '[Service]' 'Type=oneshot' 'User=root' \"ExecStart=$root/docker-state.sh\" > /etc/systemd/system/infrapulse-docker-state.service",
      "printf '%s\\n' '[Unit]' 'Description=Run InfraPulse Docker Container State Collector every 60s' '[Timer]' 'OnBootSec=15s' 'OnUnitActiveSec=60s' 'AccuracySec=5s' '[Install]' 'WantedBy=timers.target' > /etc/systemd/system/infrapulse-docker-state.timer",
      "\"$root/docker-state.sh\" >/dev/null 2>&1 || true",
      "cat <<'IP_SSL_EOF' > \"$root/ssl-certs.sh\"",
      "#!/bin/bash",
      "set -euo pipefail",
      "dir=/var/lib/infrapulse-agent/textfile; tmp=\"$dir/x509.prom.tmp\"; out=\"$dir/x509.prom\"; mkdir -p -m 0700 \"$dir\"",
      "esc() { printf '%s' \"$1\" | tr '\\r\\n\"\\\\' '    '; }",
      "declare -A seen; na=(); nb=(); errs=0; shopt -s nullglob",
      "for f in /etc/letsencrypt/live/*/fullchain.pem /etc/nginx/ssl/*.crt /etc/nginx/ssl/*.pem /etc/apache2/ssl/*.crt /etc/apache2/ssl/*.pem /etc/infrapulse/certs/*.crt /etc/infrapulse/certs/*.pem; do",
      "  [[ -f $f && -r $f ]] || continue",
      "  rp=$(readlink -f \"$f\" 2>/dev/null || printf '%s' \"$f\"); [[ -n ${seen[$rp]:-} ]] && continue; seen[$rp]=1",
      "  command -v openssl >/dev/null 2>&1 || break",
      "  info=$(openssl x509 -in \"$f\" -noout -subject -issuer -startdate -enddate -nameopt RFC2253 2>/dev/null) || { errs=$((errs+1)); continue; }",
      "  subj=$(printf '%s\\n' \"$info\" | sed -n 's/^subject=.*CN=\\([^,]*\\).*/\\1/p' | head -n1); [[ -z $subj ]] && subj=$(basename \"$f\")",
      "  iss=$(printf '%s\\n' \"$info\" | sed -n 's/^issuer=.*CN=\\([^,]*\\).*/\\1/p' | head -n1); [[ -z $iss ]] && iss=$(printf '%s\\n' \"$info\" | sed -n 's/^issuer=.*O=\\([^,]*\\).*/\\1/p' | head -n1); [[ -z $iss ]] && iss=Unknown",
      "  s_ts=$(date -u -d \"$(printf '%s\\n' \"$info\" | sed -n 's/^notBefore=//p' | head -n1)\" +%s 2>/dev/null || echo 0)",
      "  e_ts=$(date -u -d \"$(printf '%s\\n' \"$info\" | sed -n 's/^notAfter=//p' | head -n1)\" +%s 2>/dev/null || echo 0)",
      "  [[ $e_ts -gt 0 ]] || { errs=$((errs+1)); continue; }",
      "  lbl=\"embedded_key=\\\"\\\",filepath=\\\"$(esc \"$f\")\\\",issuer_CN=\\\"$(esc \"$iss\")\\\",media=\\\"linux_file\\\",source=\\\"local\\\",subject_CN=\\\"$(esc \"$subj\")\\\"\"",
      "  na+=(\"x509_cert_not_after{$lbl} $e_ts\"); nb+=(\"x509_cert_not_before{$lbl} $s_ts\")",
      "done",
      "{ if [[ ${#na[@]} -gt 0 ]]; then printf '# TYPE x509_cert_not_after gauge\\n'; printf '%s\\n' \"${na[@]}\"; printf '# TYPE x509_cert_not_before gauge\\n'; printf '%s\\n' \"${nb[@]}\"; fi; printf '# TYPE x509_read_errors gauge\\nx509_read_errors{media=\"linux_file\",source=\"local\"} %d\\n' \"$errs\"; } > \"$tmp\"",
      "mv -f \"$tmp\" \"$out\"",
      "IP_SSL_EOF",
      "chmod 0700 \"$root/ssl-certs.sh\"",
      "printf '%s\\n' '[Unit]' 'Description=InfraPulse Local SSL Certificate Scanner' '[Service]' 'Type=oneshot' 'User=root' \"ExecStart=$root/ssl-certs.sh\" > /etc/systemd/system/infrapulse-ssl-certs.service",
      "printf '%s\\n' '[Unit]' 'Description=Run InfraPulse Local SSL Certificate Scanner every 5m' '[Timer]' 'OnBootSec=20s' 'OnUnitActiveSec=300s' 'AccuracySec=10s' '[Install]' 'WantedBy=timers.target' > /etc/systemd/system/infrapulse-ssl-certs.timer",
      "\"$root/ssl-certs.sh\" >/dev/null 2>&1 || true",
      "printf '%s\\n' '[Unit]' 'Description=InfraPulse Grafana Alloy' 'After=network-online.target amazon-ssm-agent.service' 'Wants=network-online.target' '' '[Service]' 'Type=simple' 'User=root' 'Environment=AWS_REGION=ap-southeast-1' 'Environment=AWS_EC2_METADATA_DISABLED=true' 'Environment=AWS_SDK_LOAD_CONFIG=true' \"Environment=AWS_CONFIG_FILE=$root/aws-config\" 'Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null' 'Environment=AWS_PROFILE=infrapulse-ssm' \"ExecStart=$bin run --storage.path=$root/alloy-data --disable-reporting $root/config.alloy\" 'Restart=always' 'RestartSec=5' '' '[Install]' 'WantedBy=multi-user.target' > \"/etc/systemd/system/$unit\"",
      "[[ ! -e $root/decommission.requested ]]",
      "systemctl daemon-reload >/dev/null 2>&1; systemctl enable --now infrapulse-docker-state.timer infrapulse-ssl-certs.timer >/dev/null 2>&1 || true; systemctl enable \"$unit\" >/dev/null 2>&1; systemctl restart \"$unit\" >/dev/null 2>&1; sleep 2",
