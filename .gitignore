# Local credentials; keep only the distributable template.
.env
.env.*
!.env.example
!services/aiops-server/.env.example
/services/aiops-server/.env

# Sensitive or generated backups, never migration source files.
backups/
*.dump
/infrapulse-*.sql
*.tar
*.tar.gz
*.tgz

# Local execution bookkeeping, Loop Engineering state/skills, and private agent memory, not deployment input.
/.superpowers/sdd/
/.mnemon/
/.agents/
/STATE.md
/docs/Loop-run-log/
/loop-run-log*.md

# Local/stray root notes and Word documents; keep tracked docs, runbooks, and service markdown unblocked.
/*.md
!README.md
!AGENTS.md
!INTRODUCT.md
*.docx

# Private keys and credential containers must never be published.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519

# Local Python environments and test artifacts; keep lockfiles and test sources.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage*
htmlcov/

# Local Node builds/tests and private deployment mounts; retain lockfiles.
node_modules/
dist/
generated/
coverage/
.vite/
*.tsbuildinfo
test-results/
/deploy/secrets/
/services/management-backend/secrets/
/services/management-backend/private/

# AWS/Terraform local state, plans and variables; retain .terraform.lock.hcl.
.terraform/
*.tfstate*
*.tfplan
*.plan
*.tfvars
*.tfvars.json
/tests/aws/private/
