# Local credentials; keep only the distributable template.
.env
.env.*
!.env.example

# Sensitive or generated backups, never migration source files.
backups/
*.dump
/infrapulse-*.sql
*.tar
*.tar.gz
*.tgz

# Local execution bookkeeping and private agent memory, not deployment input.
/.superpowers/sdd/
/.mnemon/

# Private keys and credential containers must never be published.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519

# Local Python environments and test artifacts; keep lockfiles and test sources.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage*
htmlcov/

# Local Node builds/tests and private deployment mounts; retain lockfiles.
node_modules/
dist/
generated/
coverage/
.vite/
*.tsbuildinfo
test-results/
/deploy/secrets/
/services/management-backend/secrets/
/services/management-backend/private/

node_modules