  "panels": [
    {
      "id": 1,
      "title": "Uptime",
      "description": "Current System Up Time in seconds. Instant query; missing current samples are not replaced with historical values.",
      "type": "stat",
      "pluginVersion": "13.3.0",
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "gridPos": {
        "y": 0,
        "w": 5,
        "h": 4,
        "x": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "result": {
                  "color": "gray",
                  "text": "No data",
                  "index": 0
                },
                "match": "null"
              },
              "type": "special"
            }
          ],
          "noValue": "No data",
          "unit": "s",
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ],
            "mode": "absolute"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "percentChangeColorMode": "standard",
        "wideLayout": true,
        "justifyMode": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "showPercentChange": false,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "infrapulse-prometheus"
          },
          "editorMode": "code",
          "expr": "max(win_system_System_Up_Time{os=\"windows\",server_id=~\"${server_id:regex}\",agent_id=~\"${agent_id:regex}\",server_id!=\"\",agent_id!=\"\"})",
          "format": "time_series",
          "instant": true,
          "range": false,
          "interval": "30s",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
