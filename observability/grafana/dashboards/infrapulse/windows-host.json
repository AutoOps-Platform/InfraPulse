    {
      "id": 200,
      "title": "Metrics sample age",
      "description": "Age in seconds of the latest original uptime sample found in a 24h subquery window with 1m steps plus Prometheus selector lookback (normally 5m). Original samples can remain visible for roughly 24h+5m. Warning at 90s; critical at 300s. This is sample freshness, NOT Online status or backend health. No retained sample = No data.",
      "type": "stat",
      "pluginVersion": "13.3.0",
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "gridPos": {
        "y": 0,
        "w": 4,
        "h": 4,
        "x": 20
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "result": {
                  "color": "gray",
                  "text": "No data",
                  "index": 0
                },
                "match": "null"
              },
              "type": "special"
            }
          ],
          "noValue": "No data",
          "unit": "s",
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 90,
                "color": "yellow"
              },
              {
                "value": 300,
                "color": "red"
              }
            ],
            "mode": "absolute"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "graphMode": "none",
        "percentChangeColorMode": "standard",
        "wideLayout": true,
        "justifyMode": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "showPercentChange": false,
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "infrapulse-prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(time() - max(max_over_time(timestamp(win_system_System_Up_Time{os=\"windows\",server_id=~\"${server_id:regex}\",agent_id=~\"${agent_id:regex}\",server_id!=\"\",agent_id!=\"\"})[24h:1m])), 0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "interval": "30s",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
