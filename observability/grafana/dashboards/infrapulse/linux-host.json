    {
      "id": 73,
      "title": "Latest metrics age",
      "description": "Age of newest original uptime timestamp found in a 24h subquery window with 1m steps plus Prometheus selector lookback (normally 5m). Original samples can remain visible for roughly 24h+5m. Sample time, not Gateway receipt time or authoritative Online/Offline status. No retained sample = No data.",
      "type": "stat",
      "pluginVersion": "13.3.0",
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "infrapulse-prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_min(time() - max(max_over_time(timestamp(system_uptime{os=\"linux\",server_id=~\"${server_id:regex}\",agent_id=~\"${agent_id:regex}\",server_id!=\"\",agent_id!=\"\"})[24h:1m])), 0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
