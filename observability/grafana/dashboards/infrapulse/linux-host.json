  "panels": [
    {
      "id": 26,
      "title": "CPU usage",
      "description": "Total CPU percentage, not a rate. Source: inputs.cpu report_active=true.",
      "type": "stat",
      "pluginVersion": "13.3.0",
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "infrapulse-prometheus"
          },
          "editorMode": "code",
          "expr": "max by (server_id,agent_id,os) (cpu_usage_active{os=\"linux\",server_id=~\"${server_id:regex}\",agent_id=~\"${agent_id:regex}\",server_id!=\"\",agent_id!=\"\",cpu=\"cpu-total\"})",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
