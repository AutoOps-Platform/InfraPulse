# Current AWS Grafana identity reference only, not a complete deployment env-file.
# ECS supplies these values from its runtime configuration and secret initializer.
# See docs/deployment/aws-lab.md for actual nonsecret enrollment inputs.
# No real key/password contents or AWS access keys belong in environment values.
INFRAPULSE_IDENTITY_MODE=grafana13-id-token
INFRAPULSE_ACCEPT_EXPERIMENTAL_IDENTITY=false
# Exact Grafana cfg.AppURL, including subpath and trailing slash. This is a trust
# constraint, NOT discovery from browser input or a JWT issuer.
INFRAPULSE_GRAFANA_ISSUER=
INFRAPULSE_GRAFANA_JWKS_URL=
INFRAPULSE_GRAFANA_ORG_ID=
INFRAPULSE_GRAFANA_NAMESPACE=
# Pinned source local login/session example: password,absent. 'absent' explicitly
# accepts a signed omitted authenticatedBy; it does NOT prove password login.
INFRAPULSE_GRAFANA_AUTH_METHODS=
INFRAPULSE_ALLOW_LOOPBACK_GRAFANA_HTTP=false
INFRAPULSE_ASSERTION_ISSUER=
INFRAPULSE_ASSERTION_AUDIENCE=
INFRAPULSE_ASSERTION_KEY_ID=
# The ECS task initializer supplies the protected file at this fixed path.
INFRAPULSE_ASSERTION_KEY_FILE=/run/secrets/assertion-key
INFRAPULSE_ASSERTION_CONTEXT=
# ECS sets this to the central host's private IP and Management host port.
INFRAPULSE_MANAGEMENT_URL=
INFRAPULSE_ALLOW_PRIVATE_HTTP=true
# No Agent-control/Gateway origins, API keys or public settings endpoint.
# Optional separate identity/Management TLS trust (mounts configured separately):
# INFRAPULSE_MANAGEMENT_CA_FILE=/run/pki/management-ca.pem
# INFRAPULSE_GRAFANA_CA_FILE=/run/pki/grafana-ca.pem
