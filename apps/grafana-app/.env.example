# Operator enrollment template. Merge into the root .env for Compose; no secrets
# are values here. Do not use real key/password contents as environment variables.
INFRAPULSE_ACCEPT_EXPERIMENTAL_IDENTITY=false
# Exact Grafana cfg.AppURL, including subpath and trailing slash. This is a trust
# constraint, NOT discovery from browser input or a JWT issuer.
INFRAPULSE_GRAFANA_ISSUER=
INFRAPULSE_GRAFANA_JWKS_URL=
INFRAPULSE_GRAFANA_ORG_ID=
INFRAPULSE_GRAFANA_NAMESPACE=
# Pinned source local login/session example: password,absent. 'absent' explicitly
# accepts a signed omitted authenticatedBy; it does NOT prove password login.
INFRAPULSE_GRAFANA_AUTH_METHODS=
INFRAPULSE_ALLOW_LOOPBACK_GRAFANA_HTTP=false
INFRAPULSE_ASSERTION_ISSUER=
INFRAPULSE_ASSERTION_AUDIENCE=
INFRAPULSE_ASSERTION_KEY_ID=
# Absolute HOST filename, mounted read-only to the Grafana runtime only.
INFRAPULSE_ASSERTION_KEY_FILE=
# Agent-reachable, final HTTPS origin. No /api/v1 suffix.
INFRAPULSE_AGENT_CONTROL_URL=
# Reuse root .env AGENT_GATEWAY_ORIGIN and MANAGEMENT_GRAFANA_CONTEXT.
# Optional non-Compose runtime settings (file mounts configured separately):
# INFRAPULSE_MANAGEMENT_URL=https://management.internal.example
# INFRAPULSE_ALLOW_PRIVATE_HTTP=false
# INFRAPULSE_ASSERTION_CONTEXT=<same value as MANAGEMENT_GRAFANA_CONTEXT>
# INFRAPULSE_MANAGEMENT_CA_FILE=/run/pki/management-ca.pem
# INFRAPULSE_GRAFANA_CA_FILE=/run/pki/grafana-ca.pem
