{
  "name": "infrapulse-infrapulse-app",
  "version": "1.0.0",
  "private": true,
  "description": "Grafana-native management UI and request-bound identity adapter for InfraPulse",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "pnpm typecheck && webpack --disable-interpret -c ./webpack.config.ts --env production",
    "dev": "webpack --disable-interpret -w -c ./webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "build:backend": "node scripts/build-backend.mjs",
    "check:backend": "go vet ./...",
    "test:backend": "go test ./...",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "sign": "sign-plugin"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "13.3.0",
    "@grafana/runtime": "13.3.0",
    "@grafana/ui": "13.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@grafana/eslint-config": "10.0.0",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@swc/core": "1.15.0",
    "@swc/helpers": "0.5.23",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.0",
    "diagnostics-webpack-plugin": "1.0.1",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.0",
    "eslint-plugin-jsdoc": "52.0.0",
    "eslint-plugin-react": "7.37.0",
    "eslint-plugin-react-hooks": "7.1.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "imports-loader": "5.0.0",
    "prettier": "3.6.0",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.89.0",
    "sass-loader": "16.0.0",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.0",
    "terser-webpack-plugin": "5.3.0",
    "ts-node": "10.9.0",
    "typescript": "5.9.2",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.0",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  }
}
