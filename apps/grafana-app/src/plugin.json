{
  "$schema": "https://grafana.com/schemas/plugin/v0.0.0/plugin.schema.json",
  "type": "app",
  "name": "InfraPulse",
  "id": "infrapulse-infrapulse-app",
  "backend": true,
  "executable": "gpx_infrapulse",
  "autoEnabled": false,
  "info": {
    "description": "AWS inventory, onboarding and independent monitoring health backed by the InfraPulse Management API",
    "author": { "name": "InfraPulse" },
    "keywords": ["infrapulse", "aws", "infrastructure", "management"],
    "logos": { "small": "img/logo.svg", "large": "img/logo.svg" },
    "links": [{ "name": "Project", "url": "https://github.com/AutoOps-Platform/InfraPulse" }],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": { "grafanaDependency": ">=13.3.0 <13.4.0", "plugins": [] },
  "includes": [
    {
      "type": "page",
      "name": "VMs",
      "path": "/a/infrapulse-infrapulse-app/vms",
      "addToNav": true,
      "defaultNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "SSL Certificates",
      "path": "/a/infrapulse-infrapulse-app/ssl",
      "addToNav": true,
      "defaultNav": false,
      "role": "Viewer"
    }
  ]
}
