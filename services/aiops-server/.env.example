# =============================================================================
# InfraPulse AIOps Server (SaSa AI) Environment Template
# Copy to `.env` for local development. NEVER commit real keys or personal IDs.
# =============================================================================

# Service identity & runtime
AIOPS_ENV=development
AIOPS_SERVICE_NAME=infrapulse-aiops-server
AIOPS_AGENT_NAME=SaSa AI
AIOPS_HOST=127.0.0.1
AIOPS_PORT=8001
AIOPS_WEBHOOK_SECRET=
AIOPS_INTERNAL_API_KEY=

# Alert storm & response cache controls
AIOPS_DEDUP_COOLDOWN_SECONDS=300
AIOPS_CACHE_TTL_SECONDS=600
AIOPS_MAX_CACHE_ENTRIES=512

# LLM provider routing & fallback
AIOPS_DEFAULT_PROVIDER=deepseek
AIOPS_ENABLE_PROVIDER_FALLBACK=true

# DeepSeek & local Ollama provider
DEEPSEEK_MODE=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_LIGHTWEIGHT_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=30.0

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-r1:latest
OLLAMA_TIMEOUT_SECONDS=60.0

# Jev decision model
JEV_MODE=auto
JEV_API_URL=http://localhost:8090/v1/decision/evaluate
JEV_API_KEY=
JEV_MODEL=jev-decision-v1
JEV_TIMEOUT_SECONDS=10.0

# Optional Gemini provider
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0

# Amazon Managed Prometheus (AMP) SigV4 settings
AMP_ENDPOINT=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AMP_TIMEOUT_SECONDS=10.0

# Management backend live inventory & SSL context API
MANAGEMENT_API_BASE_URL=
MANAGEMENT_API_TOKEN=
MANAGEMENT_API_TIMEOUT_SECONDS=5.0

# Telegram HITL approval settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLL_INTERVAL_SECONDS=2.0

# Opt-in live connectivity tests
AIOPS_RUN_LIVE_TESTS=false
