# =============================================================================
# InfraPulse AIOps Server (SaSa AI) — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` inside `services/aiops-server/` for local testing.
# NEVER commit real API keys or secrets to Git.

# --- Service & Runtime Configuration ---
AIOPS_ENV=development
AIOPS_SERVICE_NAME=infrapulse-aiops-server
AIOPS_AGENT_NAME=SaSa AI
AIOPS_HOST=127.0.0.1
AIOPS_PORT=8001
AIOPS_WEBHOOK_SECRET=

# --- Alert Storm & Cache Controls (Step 7) ---
AIOPS_DEDUP_COOLDOWN_SECONDS=300
AIOPS_CACHE_TTL_SECONDS=600
AIOPS_MAX_CACHE_ENTRIES=512

# --- Task 1: DeepSeek & Ollama Provider Configuration ---
# Primary LLM provider selection: "deepseek" or "gemini"
AIOPS_DEFAULT_PROVIDER=deepseek

# DeepSeek backend mode:
#   - "ollama" : Use local Ollama inference (no cloud API key required)
#   - "api"    : Use DeepSeek Cloud API (requires DEEPSEEK_API_KEY)
#   - "auto"   : Prefer DeepSeek Cloud API if DEEPSEEK_API_KEY is set, else fallback to Ollama
DEEPSEEK_MODE=ollama

# DeepSeek Cloud API settings (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_TIMEOUT_SECONDS=30.0

# Ollama Local Inference settings (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-r1:latest
OLLAMA_TIMEOUT_SECONDS=60.0

# --- Task 2: Jev Decision Model Configuration ---
# Jev execution mode:
#   - "api"       : Call remote/local Jev Decision Model endpoint (requires JEV_API_URL & JEV_API_KEY)
#   - "heuristic" : Deterministic local fallback classifier when Jev endpoint is not yet configured
#   - "auto"      : Use "api" when JEV_API_KEY and JEV_API_URL are set, otherwise "heuristic"
JEV_MODE=auto
JEV_API_URL=http://localhost:8090/v1/decision/evaluate
JEV_API_KEY=
JEV_MODEL=jev-decision-v1
JEV_TIMEOUT_SECONDS=10.0

# --- Optional: Gemini Provider Configuration ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0

# --- Optional: Telegram HITL & Notification Configuration ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Live Connectivity Test Toggle ---
# Set to 1 only when running live integration tests against real keys/Ollama:
AIOPS_RUN_LIVE_TESTS=0
