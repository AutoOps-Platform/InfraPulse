# Lab only. Copy to .env at the workspace root; never share or commit .env.
# Fill BOTH passwords before running Compose; empty values intentionally fail.
# Single-quote password values to preserve literal $ and # characters.
# The current process environment takes precedence over this env file.
# Changing these values does NOT rotate passwords in existing data volumes.

PROMETHEUS_IMAGE_TAG=v3.13.5-busybox
GRAFANA_IMAGE_TAG=13.3.0
POSTGRES_IMAGE_TAG=18.6-bookworm

PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=5GB

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

POSTGRES_DB=infrapulse
# Bootstrap superuser, NOT an application account.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# HTTP lab only: Bearer syntax is checked; server/agent identity is self-declared,
# not authenticated or authorized. No token/key store is configured here.
# Host port is loopback-only and is NOT injected into the gateway environment.
INGEST_HOST_PORT=8000
INGEST_PROMETHEUS_WRITE_URL=http://prometheus:9090/api/v1/write
INGEST_PROMETHEUS_READY_URL=http://prometheus:9090/-/ready
INGEST_MAX_COMPRESSED_BYTES=1048576
INGEST_MAX_DECOMPRESSED_BYTES=8388608
INGEST_MAX_SERIES=5000
INGEST_MAX_SAMPLES=20000
INGEST_MAX_LABELS_PER_SERIES=64
INGEST_MAX_INFLIGHT=2
INGEST_RATE_PER_SECOND=10
INGEST_RATE_BURST=20
INGEST_MAX_SAMPLE_AGE_SECONDS=3600
INGEST_MAX_FUTURE_SKEW_SECONDS=120
INGEST_BODY_READ_TIMEOUT_SECONDS=5
INGEST_CONNECT_TIMEOUT_SECONDS=2
INGEST_READ_TIMEOUT_SECONDS=10
INGEST_WRITE_TIMEOUT_SECONDS=10
INGEST_POOL_TIMEOUT_SECONDS=1
INGEST_UPSTREAM_DEADLINE_SECONDS=12
INGEST_READY_TIMEOUT_SECONDS=1
INGEST_LOG_LEVEL=INFO
