# Lab only. Copy to .env at the workspace root; never share or commit .env.
# Fill BOTH passwords before running Compose; empty values intentionally fail.
# Single-quote password values to preserve literal $ and # characters.
# The current process environment takes precedence over this env file.
# Changing these values does NOT rotate passwords in existing data volumes.

PROMETHEUS_IMAGE_TAG=v3.13.5-busybox
GRAFANA_IMAGE_TAG=13.3.0
POSTGRES_IMAGE_TAG=18.6-bookworm

PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=5GB

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

POSTGRES_DB=infrapulse
# Bootstrap superuser, NOT an application account.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# HTTP lab only; Agent credentials are verified by Management. Assertions do not
# provide transport encryption. See docs/deployment/management-backend.md.
# Host port is loopback-only and is NOT injected into the gateway environment.
INGEST_HOST_PORT=8000
INGEST_PROMETHEUS_WRITE_URL=http://prometheus:9090/api/v1/write
INGEST_PROMETHEUS_READY_URL=http://prometheus:9090/-/ready
INGEST_MAX_COMPRESSED_BYTES=1048576
INGEST_MAX_DECOMPRESSED_BYTES=8388608
INGEST_MAX_SERIES=5000
INGEST_MAX_SAMPLES=20000
INGEST_MAX_LABELS_PER_SERIES=64
INGEST_MAX_INFLIGHT=2
INGEST_RATE_PER_SECOND=10
INGEST_RATE_BURST=20
INGEST_MAX_SAMPLE_AGE_SECONDS=3600
INGEST_MAX_FUTURE_SKEW_SECONDS=120
INGEST_BODY_READ_TIMEOUT_SECONDS=5
INGEST_CONNECT_TIMEOUT_SECONDS=2
INGEST_READ_TIMEOUT_SECONDS=10
INGEST_WRITE_TIMEOUT_SECONDS=10
INGEST_POOL_TIMEOUT_SECONDS=1
INGEST_UPSTREAM_DEADLINE_SECONDS=12
INGEST_READY_TIMEOUT_SECONDS=1
INGEST_LOG_LEVEL=INFO
INGEST_MANAGEMENT_BASE_URL=http://management:3000
INGEST_CREDENTIAL_TIMEOUT_SECONDS=2
INGEST_CREDENTIAL_CACHE_TTL_SECONDS=30
INGEST_CREDENTIAL_CACHE_MAX_ENTRIES=1024
INGEST_STATUS_INTERVAL_SECONDS=10
INGEST_STATUS_TIMEOUT_SECONDS=2
INGEST_STATUS_MAX_PENDING_AGENTS=1024
# Required fixed canonical UUID; same trust subject and explicitly seeded source.
INGEST_GATEWAY_ID=
INGEST_SERVICE_KEY_ID=
# Absolute operator-owned host path, NOT PEM contents.
INGEST_SERVICE_SIGNING_KEY_FILE=

MANAGEMENT_HOST_PORT=3001
# All FILE values below are absolute operator-owned HOST paths. Required files
# are mounted only into their specific runtime/one-off service, read-only.
MANAGEMENT_DATABASE_URL_FILE=
MANAGEMENT_MIGRATION_DATABASE_URL_FILE=
MANAGEMENT_BOOTSTRAP_DATABASE_URL_FILE=
MANAGEMENT_ADMIN_TRUST_FILE=
MANAGEMENT_SERVICE_TRUST_FILE=
# Determine from the actual Grafana instance before any real adapter rollout.
MANAGEMENT_GRAFANA_CONTEXT=
MANAGEMENT_AGENT_INGEST_BASE_URL=http://127.0.0.1:8000
MANAGEMENT_LOG_LEVEL=INFO
MANAGEMENT_REQUEST_RATE_PER_SECOND=20
MANAGEMENT_REQUEST_BURST=40
MANAGEMENT_DB_POOL_MAX=10
MANAGEMENT_DB_POOL_TIMEOUT_MS=1000
MANAGEMENT_NONCE_MAX_ENTRIES=20000

# Optional Step 4 direct TLS: compose.agent-tls.yaml (Compose >= 2.24.4).
# Leave unused for HTTP-only central lab. Agent installers NEVER accept HTTP.
# Example values in docs/deployment/telegraf-agent.md; no certificate is generated.
AGENT_CONTROL_BIND=127.0.0.1
AGENT_CONTROL_PORT=3443
AGENT_CONTROL_TLS_CERT_FILE=
AGENT_CONTROL_TLS_KEY_FILE=
AGENT_GATEWAY_BIND=127.0.0.1
AGENT_GATEWAY_PORT=8443
AGENT_GATEWAY_ORIGIN=
AGENT_GATEWAY_TLS_CERT_FILE=
AGENT_GATEWAY_TLS_KEY_FILE=
AGENT_GATEWAY_TLS_CA_FILE=
# DNS SAN in Gateway cert, also assigned as its Docker-network alias for health.
INGEST_TLS_SERVER_NAME=
